# ═══════════════════════════════════════════════════════════════════════════════
# CyberGuard SOC & AI Multi-Modal Defense — Docker Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env before starting Docker if you wish to customize secrets:
#   copy .env.docker.example .env

# Server & Security
PORT=3000
# Initial administrator password (if left empty, a secure one-time password is generated in data/.admin_bootstrap_credentials)
CYBERGUARD_ADMIN_PASSWORD=
DATABASE_PATH=/app/data/cyberguard.db
# Supabase PostgreSQL Database URL (Leave empty to use local container SQLite: /app/data/cyberguard.db)
DATABASE_URL=

# CORS Policy: Allowed origins for Vercel, GitHub Pages, and local developers
CYBERGUARD_CORS_ORIGINS=https://cyber-guard-backend-ashen.vercel.app,https://arthur-2407.github.io,http://localhost:3000,http://127.0.0.1:3000

# Secure Tunnel Configuration (Optional):
# - Leave CLOUDFLARE_TUNNEL_TOKEN empty to automatically use a Cloudflare Quick Tunnel (https://*.trycloudflare.com).
# - Or set your Cloudflare Tunnel Token if you configured a permanent named tunnel on cloudflare.com.
CLOUDFLARE_TUNNEL_TOKEN=

# Threat Intelligence Providers (Optional API Keys)
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_API_KEY=
URLHAUS_ENABLED=true
URLHAUS_AUTH_KEY=

# Email Alert Dispatch (true = mock logs to data/email_alerts.log; false = live SMTP)
EMAIL_TEST_MODE=true

# Model Thread Concurrency
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
