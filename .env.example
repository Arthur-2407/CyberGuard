# ==============================================================================
# CyberGuard Zero-Cost Email Alert Integration — Example Environment Template
# ==============================================================================
# Copy this file to .env or configure in your deployment secrets manager.
# NEVER commit .env or real API keys to version control.

# Database Configuration: Supabase PostgreSQL (or leave empty for SQLite fallback)
# Format: postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Core Email Toggle & Provider (Free Tier Brevo Transactional API)
EMAIL_ENABLED=true
EMAIL_PROVIDER=brevo
BREVO_API_KEY=

# Sender Identity (Must be an authorized/verified sender in your Brevo account)
EMAIL_FROM=
EMAIL_FROM_NAME=CyberGuard Security

# Alert Recipient(s) (Comma-separated for multiple SOC analysts)
EMAIL_ALERT_RECIPIENTS=

# Policy & Gating Thresholds
EMAIL_ALERT_THRESHOLD=85
EMAIL_ALERT_MIN_SEVERITY=HIGH
EMAIL_ALERT_COOLDOWN_SECONDS=300

# Zero-Cost Application Safeguard (Brevo free plan allowance: 300/day)
EMAIL_DAILY_LIMIT=250

# Test & Dry-Run Mode (Set true to test mock dispatch without external API calls)
EMAIL_TEST_MODE=false

# Threat Intelligence Integrations
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_API_KEY=
URLHAUS_ENABLED=true
URLHAUS_AUTH_KEY=

# Initial Administrator Bootstrap Credential
# If left blank, a cryptographically random one-time password is generated and saved to data/.admin_bootstrap_credentials
CYBERGUARD_ADMIN_PASSWORD=
