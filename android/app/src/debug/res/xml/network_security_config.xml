<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      DEBUG BUILD ONLY:
      Permits cleartext HTTP communication exclusively during local development
      with Docker instances running on the local workstation or local LAN.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
