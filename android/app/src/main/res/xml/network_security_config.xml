<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      PRODUCTION / MAIN BUILD CONFIGURATION:
      Strictly enforces TLS (HTTPS/WSS) by default across all remote cloud domains and tunnels.
      Cleartext HTTP is strictly constrained only to private-network development addresses,
      local hotspot gateways, and .local mDNS hostnames.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">172.16.31.2</domain>
        <domain includeSubdomains="false">10.103.174.181</domain>
        <domain includeSubdomains="false">172.20.112.1</domain>
        <domain includeSubdomains="false">192.168.43.1</domain>
        <domain includeSubdomains="false">172.20.10.1</domain>
        <domain includeSubdomains="false">192.168.29.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
